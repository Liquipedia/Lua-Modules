{
	"$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
	"runtime.version": "Lua 5.1",
	"runtime.plugin": "lua/plugins/sumneko_plugin.lua",
	"completion.autoRequire": false,
	"completion.requireSeparator": "/",
	"runtime.path": [
		"lua/wikis/commons/?.lua",
		"?.lua"
	],
	"runtime.pathStrict": false,
	"diagnostics.groupSeverity": {
		"ambiguity": "Error",
		"await": "Error",
		"conventions": "Error",
		"duplicate": "Error",
		"global": "Error",
		"luadoc": "Error",
		"strict": "Error",
		"strong": "Error",
		"type-check": "Error",
		"unbalanced": "Error"
	},
	"diagnostics.severity": {
		"deprecated": "Warning!",
		"lowercase-global": "Information!",
		"undefined-env-child": "Information!",
		"trailing-space": "Error"
	},
	"diagnostics.neededFileStatus": {
		"codestyle-check": "None",
		"name-style-check": "None"
	},
	"addonRepositoryPath": "$LUALS_ADDONS",
	"workspace.library": [
		"${addons}/busted/module/library",
		"${addons}/luassert/module/library",
	],
	"workspace.ignoreDir": [
		".vscode",
		"lua/3rd"
	],
	"runtime.special": {
		"Lua.import": "require",
		"Lua.requireIfExists": "require",
		"mw.loadData": "require"
	}
}
